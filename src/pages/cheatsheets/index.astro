---
import { readdir } from "node:fs/promises"
import path from "node:path"

import MetaPage from "@/components/MetaPage.astro"
import Layout from "@/layouts/Layout.astro"
import { getCheatsheets } from "@/lib/content"

// 1. Get collection sheets
const collectionSheets = await getCheatsheets()

// 2. Scan public/static/cheatsheets directory for categories and their PDFs
const staticDir = path.join(process.cwd(), "public", "static", "cheatsheets")
const staticEntries = await readdir(staticDir, { withFileTypes: true }).catch(
  () => [],
)
const staticCategories = staticEntries
  .filter((entry) => entry.isDirectory())
  .map((entry) => entry.name.toLowerCase())

// 3. Scan src/content/cheatsheets directory for categories
const contentDir = path.join(process.cwd(), "src", "content", "cheatsheets")
const contentEntries = await readdir(contentDir, { withFileTypes: true }).catch(
  () => [],
)
const contentCategories = contentEntries
  .filter((entry) => entry.isDirectory())
  .map((entry) => entry.name.toLowerCase())

// Combine categories
const categoriesList = Array.from(
  new Set([...staticCategories, ...contentCategories]),
).sort()

// Define category metadata mappings
const CATEGORY_META: Record<string, { title: string; description: string }> = {
  htb: {
    title: "Hack The Box",
    description:
      "Downloadable reference sheets for Hack The Box modules, Active Directory, web hacking, and privilege escalation.",
  },
  owasp: {
    title: "OWASP",
    description:
      "Reference sheets for OWASP Top 10 vulnerabilities, API security, and secure coding practices.",
  },
}

const getCategoryMeta = (category: string) => {
  const key = category.toLowerCase()
  return (
    CATEGORY_META[key] ?? {
      title: category.toUpperCase(),
      description: `${category.toUpperCase()} reference sheets and guides.`,
    }
  )
}

// Map categories to display objects with counts
const categories = await Promise.all(
  categoriesList.map(async (category) => {
    const meta = getCategoryMeta(category)

    // Count static PDFs
    const catStaticDir = path.join(staticDir, category)
    const staticPdfs = await readdir(catStaticDir, { withFileTypes: true })
      .then((entries) =>
        entries.filter(
          (entry) =>
            entry.isFile() && entry.name.toLowerCase().endsWith(".pdf"),
        ),
      )
      .catch(() => [])
    const staticCount = staticPdfs.length

    // Count collection sheets
    const collectionCount = collectionSheets.filter((sheet) => {
      const parts = sheet.id.split("/")
      const idCategory = parts.length > 1 ? parts[0].toLowerCase() : null
      const hasTag = sheet.data.tags
        ?.map((t) => t.toLowerCase())
        .includes(category)
      return idCategory === category || hasTag
    }).length

    const totalCount = staticCount + collectionCount

    return {
      slug: category,
      title: meta.title,
      description: meta.description,
      count: totalCount,
    }
  }),
)

const crumbs = [{ label: "Cheatsheets", href: "/cheatsheets" }]
---

<Layout crumbs={crumbs}>
  <MetaPage
    slot="head"
    title="Cheatsheets"
    description="Categorized reference sheets and security guides."
  />
  <ul>
    {categories.map((category) => (
      <li>
        <a href={`/cheatsheets/${category.slug}`}>
          <strong>{category.title}</strong>
          <p>{category.description}</p>
          <small>{category.count} {category.count === 1 ? "cheatsheet" : "cheatsheets"}</small>
        </a>
      </li>
    ))}
  </ul>
</Layout>

<style>
  ul {
    display: flex;
    flex-direction: column;
    gap: var(--space-m);
    list-style: none;
    padding: 0;
    margin: 0;
  }

  li a {
    display: block;
    padding: var(--space-m);
    border: 1px solid var(--border);
    border-radius: var(--radius-m);
    color: var(--foreground);
    text-decoration: none;
    transition:
      border-color 150ms ease,
      transform 150ms ease;
  }

  li a:hover {
    border-color: var(--foreground);
    transform: translateY(-1px);
  }

  strong {
    display: block;
    margin-bottom: var(--space-3xs);
  }

  p,
  small {
    color: var(--muted-foreground);
  }
</style>
