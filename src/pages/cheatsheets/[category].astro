---
import { readdir } from "node:fs/promises"
import path from "node:path"

import MetaPage from "@/components/MetaPage.astro"
import Layout from "@/layouts/Layout.astro"
import { getCheatsheets } from "@/lib/content"

export async function getStaticPaths() {
  const staticDir = path.join(process.cwd(), "public", "static", "cheatsheets")
  const staticEntries = await readdir(staticDir, { withFileTypes: true }).catch(
    () => [],
  )
  const staticCategories = staticEntries
    .filter((entry) => entry.isDirectory())
    .map((entry) => entry.name.toLowerCase())

  const contentDir = path.join(process.cwd(), "src", "content", "cheatsheets")
  const contentEntries = await readdir(contentDir, {
    withFileTypes: true,
  }).catch(() => [])
  const contentCategories = contentEntries
    .filter((entry) => entry.isDirectory())
    .map((entry) => entry.name.toLowerCase())

  const categories = Array.from(
    new Set([...staticCategories, ...contentCategories]),
  )

  return categories.map((category) => ({
    params: { category },
  }))
}

const { category } = Astro.props
const paramCategory = Astro.params.category as string

// Define category metadata mappings (reused here for page metadata)
const CATEGORY_META: Record<string, { title: string; description: string }> = {
  htb: {
    title: "Hack The Box",
    description:
      "Downloadable reference sheets for Hack The Box modules, Active Directory, web hacking, and privilege escalation.",
  },
  owasp: {
    title: "OWASP",
    description:
      "Reference sheets for OWASP Top 10 vulnerabilities, API security, and secure coding practices.",
  },
}

const getCategoryMeta = (cat: string) => {
  const key = cat.toLowerCase()
  return (
    CATEGORY_META[key] ?? {
      title: cat.toUpperCase(),
      description: `${cat.toUpperCase()} reference sheets and guides.`,
    }
  )
}

const meta = getCategoryMeta(paramCategory)

// 1. Get static PDFs in this category
const catStaticDir = path.join(
  process.cwd(),
  "public",
  "static",
  "cheatsheets",
  paramCategory,
)
const staticPdfs = await readdir(catStaticDir, { withFileTypes: true })
  .then((entries) =>
    entries
      .filter(
        (entry) => entry.isFile() && entry.name.toLowerCase().endsWith(".pdf"),
      )
      .map((entry) => ({
        title: entry.name.replace(/\.pdf$/i, "").replaceAll("_", " "),
        description: `Download the ${meta.title} PDF reference sheet.`,
        pdf: `/static/cheatsheets/${paramCategory}/${entry.name}`,
        tags: [paramCategory, "pdf"],
      })),
  )
  .catch(() => [])

// 2. Get collection sheets in this category
const collectionSheets = await getCheatsheets()
const catCollectionSheets = collectionSheets
  .filter((sheet) => {
    const parts = sheet.id.split("/")
    const idCategory = parts.length > 1 ? parts[0].toLowerCase() : null
    const hasTag = sheet.data.tags
      ?.map((t) => t.toLowerCase())
      .includes(paramCategory)
    return idCategory === paramCategory || hasTag
  })
  .map((sheet) => ({
    title: sheet.data.title,
    description: sheet.data.description,
    pdf: sheet.data.pdf,
    tags: sheet.data.tags ?? ["pdf"],
  }))

const cheatsheets = [...catCollectionSheets, ...staticPdfs]
const uniqueCheatsheets = Array.from(
  new Map(cheatsheets.map((sheet) => [sheet.pdf, sheet])).values(),
)

const crumbs = [
  { label: "Cheatsheets", href: "/cheatsheets" },
  { label: meta.title, href: `/cheatsheets/${paramCategory}` },
]
---

<Layout crumbs={crumbs}>
  <MetaPage
    slot="head"
    title={`${meta.title} Cheatsheets`}
    description={meta.description}
  />
  <ul>
    {uniqueCheatsheets.map((sheet) => (
      <li>
        <a href={sheet.pdf} target="_blank" rel="noopener noreferrer">
          <strong>{sheet.title}</strong>
          <p>{sheet.description}</p>
          <small>{sheet.tags.join(" · ")}</small>
        </a>
      </li>
    ))}
  </ul>
</Layout>

<style>
  ul {
    display: flex;
    flex-direction: column;
    gap: var(--space-m);
    list-style: none;
    padding: 0;
    margin: 0;
  }

  li a {
    display: block;
    padding: var(--space-m);
    border: 1px solid var(--border);
    border-radius: var(--radius-m);
    color: var(--foreground);
    text-decoration: none;
    transition:
      border-color 150ms ease,
      transform 150ms ease;
  }

  li a:hover {
    border-color: var(--foreground);
    transform: translateY(-1px);
  }

  strong {
    display: block;
    margin-bottom: var(--space-3xs);
  }

  p,
  small {
    color: var(--muted-foreground);
  }
</style>
