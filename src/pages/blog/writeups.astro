---
import BlogCard from "@/components/BlogCard.astro"
import MetaPage from "@/components/MetaPage.astro"
import Layout from "@/layouts/Layout.astro"
import { getPosts } from "@/lib/content"

const posts = await getPosts()
const writeups = posts.filter((post) => post.id.startsWith("writeups/"))

const crumbs = [
  { label: "Blog", href: "/blog" },
  { label: "Writeups", href: "/blog/writeups" },
]
---

<Layout crumbs={crumbs}>
  <MetaPage
    slot="head"
    title="Writeups"
    description="Detailed walkthroughs and writeups for CTF challenges, Hack The Box machines, and security challenges."
  />
  <ul>
    {writeups.map((post) => <BlogCard post={post} />)}
  </ul>
</Layout>

<style>
  ul {
    display: flex;
    flex-direction: column;
    gap: var(--space-m);
    list-style: none;
    padding: 0;
    margin: 0;
  }
</style>
