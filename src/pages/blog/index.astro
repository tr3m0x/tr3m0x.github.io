---
import MetaPage from "@/components/MetaPage.astro"
import Layout from "@/layouts/Layout.astro"
import { getPosts } from "@/lib/content"

const posts = await getPosts()
const writeupsCount = posts.filter((post) =>
  post.id.startsWith("writeups/"),
).length
const articlesCount = posts.filter((post) =>
  post.id.startsWith("articles/"),
).length

const categories = [
  {
    slug: "writeups",
    title: "Writeups",
    description:
      "Walkthroughs and detailed writeups for CTF challenges, Hack The Box machines, and other security platforms.",
    count: writeupsCount,
  },
  {
    slug: "articles",
    title: "Articles",
    description:
      "In-depth articles, security research, analysis, and general development notes.",
    count: articlesCount,
  },
]

const crumbs = [{ label: "Blog", href: "/blog" }]
---

<Layout crumbs={crumbs}>
  <MetaPage
    slot="head"
    title="Blog"
    description="Browse security writeups and articles."
  />
  <ul>
    {categories.map((category) => (
      <li>
        <a href={`/blog/${category.slug}`}>
          <strong>{category.title}</strong>
          <p>{category.description}</p>
          <small>{category.count} {category.count === 1 ? "post" : "posts"}</small>
        </a>
      </li>
    ))}
  </ul>
</Layout>

<style>
  ul {
    display: flex;
    flex-direction: column;
    gap: var(--space-m);
    list-style: none;
    padding: 0;
    margin: 0;
  }

  li a {
    display: block;
    padding: var(--space-m);
    border: 1px solid var(--border);
    border-radius: var(--radius-m);
    color: var(--foreground);
    text-decoration: none;
    transition:
      border-color 150ms ease,
      transform 150ms ease;
  }

  li a:hover {
    border-color: var(--foreground);
    transform: translateY(-1px);
  }

  strong {
    display: block;
    margin-bottom: var(--space-3xs);
  }

  p,
  small {
    color: var(--muted-foreground);
  }
</style>
