---
import BlogCard from "@/components/BlogCard.astro"
import MetaPage from "@/components/MetaPage.astro"
import Layout from "@/layouts/Layout.astro"
import { getPosts } from "@/lib/content"

const posts = await getPosts()
const articles = posts.filter((post) => post.id.startsWith("articles/"))

const crumbs = [
  { label: "Blog", href: "/blog" },
  { label: "Articles", href: "/blog/articles" },
]
---

<Layout crumbs={crumbs}>
  <MetaPage
    slot="head"
    title="Articles"
    description="In-depth articles, security research, analysis, and general development notes."
  />
  <ul>
    {articles.map((post) => <BlogCard post={post} />)}
  </ul>
</Layout>

<style>
  ul {
    display: flex;
    flex-direction: column;
    gap: var(--space-m);
    list-style: none;
    padding: 0;
    margin: 0;
  }
</style>
