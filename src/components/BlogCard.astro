---
import { formatDate } from "@/lib/utils"
import { Image } from "astro:assets"
import { getEntries, type CollectionEntry } from "astro:content"

type Props = { post: CollectionEntry<"blog"> }

const { post } = Astro.props
const authors = await getEntries(post.data.authors)
const showDescription = post.id.includes('/htb/') || post.id.includes('/thm/')
---

<li>
  {post.data.image && (
      <a href={`/blog/${post.id}`} tabindex="-1" aria-hidden="true">
        <Image src={post.data.image} alt="" width={640} height={360} />
      </a>
    )}
  <entry-info>
    <a href={`/blog/${post.id}`}
      >{post.data.title}
      {post.data.draft && <span class="draft-badge">DRAFT</span>}</a
    >
    <entry-meta>
      {authors.length > 0 && (
          <entry-authors>
            <author-avatars>
              {authors.map((author) => (
                <img
                  src={author.data.avatar}
                  alt={author.data.name}
                  width="18"
                  height="18"
                />
              ))}
            </author-avatars>
            <author-names>
              {authors.map((author, i) => (
                <>{i > 0 && ", "}{author.data.name}</>
              ))}
            </author-names>
          </entry-authors>
        )}
      <time datetime={post.data.date.toISOString()}
        >{formatDate(post.data.date)}</time
      >
      {post.data.tags && (
          <entry-tags>
            {post.data.tags.map((tag) => (
              <span>#{tag}</span>
            ))}
          </entry-tags>
        )}
    </entry-meta>
    {showDescription && post.data.description && (
      <p>{post.data.description}</p>
    )}
  </entry-info>
</li>

<style>
  li {
    display: flex;
    align-items: flex-start;
    gap: var(--space-s);

    > a {
      flex-shrink: 0;
      inline-size: 15rem;
      aspect-ratio: 16 / 9;
      overflow: hidden;
      border-radius: var(--radius-s);

      :global(img) {
        inline-size: 100%;
        block-size: 100%;
        object-fit: cover;
      }
    }

    entry-info {
      display: flex;
      flex-direction: column;
      gap: var(--space-3xs);
      flex: 1;
      min-inline-size: 0;

      > a {
        font-size: var(--step-1);
        line-height: 1.3;
        font-weight: var(--font-weight-medium);
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
      }

      entry-meta {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: var(--space-3xs);
        font-size: var(--step--1);
        color: var(--muted-foreground);

        entry-authors {
          display: flex;
          align-items: center;
          gap: var(--space-3xs);

          author-avatars {
            display: flex;
            margin-block-end: -0.1em;

            img {
              border-radius: var(--radius-full);
              box-shadow: 0 0 0 1.5px var(--background);

              &:not(:first-child) {
                margin-inline-start: -0.375rem;
              }
            }
          }
        }

        entry-authors ~ time::before {
          content: "·";
          margin-inline-end: var(--space-3xs);
        }

        entry-tags {
          display: flex;
          flex-wrap: wrap;
          gap: var(--space-3xs);

          span {
            color: color-mix(
              in oklab,
              var(--muted-foreground) 50%,
              transparent
            );
          }
        }

        time ~ entry-tags::before {
          content: "·";
        }
      }

      p {
        color: var(--muted-foreground);
        margin: 0;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
        font-size: var(--step--1);
        line-height: 1.4;
      }
    }

    .draft-badge {
      display: inline-block;
      margin-inline-start: var(--space-3xs);
      padding: 0.1em 0.5em;
      font-size: var(--step--2);
      font-weight: var(--font-weight-medium);
      color: #f59e0b;
      border: 1px solid #f59e0b;
      border-radius: var(--radius-s);
      vertical-align: middle;
      text-decoration: none;
    }

    @media (width < 40rem) {
      flex-direction: column;

      > a {
        inline-size: 100%;
        max-inline-size: 32rem;
      }
    }
  }
</style>
